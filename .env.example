# Copy to .env (never commit .env). Docker Compose reads it automatically.
# Grafana admin password (default "admin" for local use only).
GRAFANA_ADMIN_PASSWORD=change-me
# Production: host folder with SoLEXS L1 day folders (AL1_SLX_L1_YYYYMMDD_v*), as seen by the Docker engine.
# With Docker Engine in WSL Ubuntu:  /mnt/d/MLOPS_CP/Data/SoLEXS
FLARE_RAW_SOLEXS_HOST=./data/raw_empty
# First production day (the day after holdout2). Only change it for tests.
FLARE_PRODUCTION_START=2026-11-13
