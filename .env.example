# Copy to .env (never commit .env). Docker Compose reads it automatically.
# Grafana admin password (default "admin" for local use only).
GRAFANA_ADMIN_PASSWORD=change-me
# Production: host folder with SoLEXS L1 day folders (AL1_SLX_L1_YYYYMMDD_v*), as seen by the Docker engine.
# With Docker Engine in WSL Ubuntu:  /mnt/d/MLOPS_CP/Data/SoLEXS
FLARE_RAW_SOLEXS_HOST=./data/raw_empty
# First production day (the day after holdout2). Only change it for tests.
FLARE_PRODUCTION_START=2026-11-13
# API key(s) for POST /predict (header X-API-Key). Comma-separated: add the new key, deploy, update clients, remove the old.
# scripts\up.ps1 generates a random key here if this line is missing.
FLARE_API_KEYS=
# Rate limits (requests per minute): anonymous clients per IP, and per valid API key.
FLARE_RATE_LIMIT_PER_MINUTE=300
FLARE_RATE_LIMIT_KEY_PER_MINUTE=6000
# HTTPS: set to your domain (DNS A record -> server, ports 80/443 open) for automatic Let's Encrypt certificates.
# Leave empty for plain HTTP on the server IP.
SITE_ADDRESS=
ACME_EMAIL=
# Alert e-mail through any SMTP relay (leave empty: alerts stay visible in Alertmanager at http://localhost:9093).
SMTP_SMARTHOST=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
